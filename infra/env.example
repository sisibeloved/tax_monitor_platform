# Local Compose example only. Replace these values; never reuse them as production secrets.
POSTGRES_DB=tax_risk
POSTGRES_USER=tax_risk_owner
POSTGRES_PASSWORD=replace-for-local-development-only
POSTGRES_APP_USER=tax_risk_app
POSTGRES_APP_PASSWORD=replace-for-local-application-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Compose-internal service names are postgres and redis (not localhost).
MIGRATION_DATABASE_URL=postgresql+psycopg://tax_risk_owner:replace-for-local-development-only@postgres:5432/tax_risk
DATABASE_URL=postgresql+psycopg://tax_risk_app:replace-for-local-application-only@postgres:5432/tax_risk
REDIS_URL=redis://redis:6379/0

API_PORT=8000
WEB_PORT=8080
QUARTERLY_WORKER_CONCURRENCY=4
MONTHLY_WORKER_CONCURRENCY=4
EXPORT_WORKER_CONCURRENCY=2
VITE_API_BASE_URL=

# Local-only independent HMAC secrets. Production values must come from a secret store.
EXPORT_DOWNLOAD_SECRET=local-only-export-download-signing-secret-change-me
WORKER_SCOPE_SECRET=local-only-worker-scope-signing-secret-change-me

# Local acceptance identity. Never copy these fixed values into a deployed environment.
ENVIRONMENT=development
DEVELOPMENT_PRINCIPAL_ENABLED=true
DEVELOPMENT_PRINCIPAL_SECRET=local-only-tax-risk-development-secret-do-not-use-in-production
DEVELOPMENT_PRINCIPAL='{"allowed_company_ids":[],"organization_path":"/group","roles":["group-tax"],"subject":"local-group-tax"}'
DEVELOPMENT_PRINCIPAL_SIGNATURE=2909c75e972a78e525001c284bbcf21d4cb65b3e833f8ede076f0ca533c90c65
